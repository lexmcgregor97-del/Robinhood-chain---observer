RPC_URL=
# Optional comma- or whitespace-separated backup providers. Atlas fails over on
# timeouts, HTTP 403/408/429, and provider 5xx responses.
RPC_FALLBACK_URLS=
PORT=3000
POLL_INTERVAL_MS=30000
RPC_MIN_INTERVAL_MS=400
RPC_JITTER_MS=100

SIGNAL_WINDOW_MS=60000
SIGNAL_BASELINE_MS=300000
SIGNAL_HISTORY_MS=600000
SIGNAL_MIN_SWAPS=3

PAPER_INITIAL_CASH=1000
PAPER_WETH_INITIAL_CASH=0.1
PAPER_MAX_POSITIONS=3
PAPER_WETH_MAX_ENTRY=0.01
PAPER_USDG_MAX_ENTRY=100
PAPER_WETH_GAS_PER_SIDE=0.00001
PAPER_USDG_GAS_PER_SIDE=0.03
# Required before a qualifying epoch: a recent successful on-chain V2 router
# swap receipt used to derive the WETH gas constant. Comma-separate only router
# addresses independently confirmed for this chain.
PAPER_GAS_MEASUREMENT_TX=
PAPER_V2_ROUTER_ADDRESSES=
PAPER_GAS_MAX_AGE_MS=604800000
GAS_VERIFICATION_INTERVAL_MS=3600000
# Read-only V2 sell simulation. Atlas requires both a recent observed seller
# and an independent Atlas-address simulation using temporary RPC state
# overrides. It never signs, broadcasts, or changes chain state.
SELL_PROBE_INTERVAL_MS=300000
SELL_PROBE_MAX_AGE_MS=900000
SELL_PROBE_MAX_SWAP_AGE_BLOCKS=1200
SELL_PROBE_MAX_SLIPPAGE_BPS=500
# Maximum candidate storage slot checked when locating standard ERC-20 balance
# and allowance mappings for the temporary state override.
SELL_PROBE_MAX_STORAGE_SLOT=24
# Robinhood L2 WETH follows Arbitrum aeWETH / OpenZeppelin 4.8.3, whose inherited
# ERC20Upgradeable balance mapping is slot 51. If the one-call canary cannot
# echo this value, override probing stays disabled for the process.
SELL_PROBE_CANARY_BALANCE_SLOT=51
# Do not repeatedly rediscover unsupported/non-standard token storage layouts.
SELL_PROBE_NEGATIVE_CACHE_MS=3600000
PAPER_CYCLE_MS=10000
# Paper and shadow sampling run continuously by default. These are emergency
# brakes; set either to true only when intentionally quarantining that path.
PAPER_ENTRIES_PAUSED=false
SHADOW_RECORDING_PAUSED=false

# Set this only after mounting a Railway volume at /data.
STATE_FILE=/data/observer-state.json
STATE_SAVE_MS=30000
# Defaults to /data/evidence when STATE_FILE is under /data.
EVIDENCE_DIR=/data/evidence

# Use a dedicated Turnkey API user outside root quorum with no applicable ALLOW
# policies and an applicable DENY policy. Reads do not require an ALLOW policy.
# Seal the private key in Railway.
TURNKEY_ORGANIZATION_ID=
TURNKEY_WALLET_ID=
TURNKEY_WALLET_ADDRESS=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_POLICY_ID=
# Set true only after independently verifying the policy above is read-only.
TURNKEY_READ_ONLY_ATTESTED=false

# Future micro-mainnet boundary. Leave these defaults unchanged in PAPER_ONLY.
# The signing API key must belong to a separate non-root Turnkey user. It must
# not be the read-only API key above. Setting these values still cannot submit a
# transaction in the review branch: the strategy-to-execution path is deliberately
# disconnected pending independent review.
ATLAS_EXECUTION_MODE=PAPER_ONLY
MICRO_MAINNET_ENABLED=false
TURNKEY_SIGNING_ORGANIZATION_ID=
TURNKEY_SIGNING_WALLET_ADDRESS=
TURNKEY_SIGNING_BUY_POLICY_ID=
TURNKEY_SIGNING_SELL_POLICY_ID=
TURNKEY_SIGNING_APPROVAL_POLICY_ID=
TURNKEY_SIGNING_API_PUBLIC_KEY=
MICRO_MAINNET_V2_ROUTERS=
MICRO_MAINNET_MAX_WETH_PER_TX_WEI=
MICRO_MAINNET_MAX_WETH_DAILY_WEI=
MICRO_MAINNET_MAX_GAS=400000
MICRO_MAINNET_MAX_FEE_PER_GAS_WEI=
# Exact form: ENABLE_ATLAS_MICRO_MAINNET:4663:<lowercase-wallet-address>
MICRO_MAINNET_CONFIRMATION=
# Never add this one-shot verification secret to the Railway web service. Supply
# it only to `npm run verify:signing` in an isolated operator environment.
TURNKEY_SIGNING_VERIFY_API_PRIVATE_KEY=
# A separate operator P-256 key signs the one-shot result. Keep only the public
# key and resulting file in the web runtime; never add the private key there.
TURNKEY_SIGNING_ATTESTATION_FILE=/data/signing-policy-attestation.json
TURNKEY_SIGNING_ATTESTATION_PUBLIC_KEY_PEM_B64=
TURNKEY_SIGNING_ATTESTATION_PRIVATE_KEY_PEM_B64=
# Private JSON produced from the real Turnkey policy test run. It contains
# structured allow/deny cases and activity IDs; the verifier fetches and checks
# every activity before signing the attestation. Repeat the matrix every 24 h.
TURNKEY_SIGNING_BEHAVIORAL_MATRIX_FILE=
TURNKEY_SIGNING_ATTESTATION_TTL_MS=21600000
