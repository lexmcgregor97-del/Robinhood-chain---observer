RPC_URL=
# Optional comma- or whitespace-separated backup providers. Atlas fails over on
# timeouts, HTTP 403/408/429, and provider 5xx responses.
RPC_FALLBACK_URLS=
PORT=3000
POLL_INTERVAL_MS=30000
RPC_MIN_INTERVAL_MS=400
RPC_JITTER_MS=100

SIGNAL_WINDOW_MS=60000
SIGNAL_BASELINE_MS=300000
SIGNAL_HISTORY_MS=600000
SIGNAL_MIN_SWAPS=3

PAPER_INITIAL_CASH=1000
PAPER_WETH_INITIAL_CASH=0.1
PAPER_MAX_POSITIONS=3
PAPER_WETH_MAX_ENTRY=0.01
PAPER_USDG_MAX_ENTRY=100
PAPER_WETH_GAS_PER_SIDE=0.00001
PAPER_USDG_GAS_PER_SIDE=0.03
# Required before a qualifying epoch: a recent successful on-chain V2 router
# swap receipt used to derive the WETH gas constant. Comma-separate only router
# addresses independently confirmed for this chain.
PAPER_GAS_MEASUREMENT_TX=
PAPER_V2_ROUTER_ADDRESSES=
PAPER_GAS_MAX_AGE_MS=604800000
GAS_VERIFICATION_INTERVAL_MS=3600000
# Read-only V2 sell simulation. Atlas uses the V2 router allowlist above and a
# recent observed seller; it never signs or broadcasts the probe call.
SELL_PROBE_INTERVAL_MS=300000
SELL_PROBE_MAX_AGE_MS=900000
SELL_PROBE_MAX_SWAP_AGE_BLOCKS=1200
SELL_PROBE_MAX_SLIPPAGE_BPS=500
PAPER_CYCLE_MS=10000
# Paper and shadow sampling run continuously by default. These are emergency
# brakes; set either to true only when intentionally quarantining that path.
PAPER_ENTRIES_PAUSED=false
SHADOW_RECORDING_PAUSED=false

# Set this only after mounting a Railway volume at /data.
STATE_FILE=/data/observer-state.json
STATE_SAVE_MS=30000
# Defaults to /data/evidence when STATE_FILE is under /data.
EVIDENCE_DIR=/data/evidence

# Use a dedicated Turnkey API user outside root quorum with no applicable ALLOW
# policies and an applicable DENY policy. Reads do not require an ALLOW policy.
# Seal the private key in Railway.
TURNKEY_ORGANIZATION_ID=
TURNKEY_WALLET_ID=
TURNKEY_WALLET_ADDRESS=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_POLICY_ID=
# Set true only after independently verifying the policy above is read-only.
TURNKEY_READ_ONLY_ATTESTED=false
