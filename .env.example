# Observation works without a wallet. Never put a real key in this file.
LIVE_TRADING_ENABLED=disabled
WALLET_PRIVATE_KEY=
# Populate only from the verified addresses in chain-config.js.
ALLOWED_ROUTER_ADDRESSES=
MAX_TRADE_WEI=
MAX_DAILY_SPEND_WEI=
MAX_GAS_WEI=
MAX_SLIPPAGE_BPS=100
PAPER_INITIAL_CASH=1000
PAPER_MAX_POSITIONS=3

# Set to a mounted Railway volume path to persist scanner and paper state.
STATE_FILE=
STATE_SAVE_MS=30000
PAPER_CYCLE_MS=30000
PAPER_WETH_PROBE_WEI=1000000000000000
PAPER_USDG_PROBE_UNITS=10
